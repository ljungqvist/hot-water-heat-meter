  {
    "id": "735513bf4b272e8f",
    "type": "change",
    "z": "85c86590a261c1bf",
    "name": "Set standby heat loss",
    "rules": [
      {
        "t": "set",
        "p": "lossPower",
        "pt": "msg",
        "to": "lossPower",
        "tot": "env"
      },
      {
        "t": "set",
        "p": "estimatedFullEnergy",
        "pt": "msg",
        "to": "estimatedFullEnergy",
        "tot": "env"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "(    \t    $waterEnergy := (payload ? payload : 0);\t    $capacity := estimatedFullEnergy; /* kWh */\t    $interval := 36 /* s */ / 3600; /* h */\t    - ($capacity + $waterEnergy) / $capacity * (lossPower / 1000)  *$interval;\t)",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 530,
    "y": 60,
    "wires": [
