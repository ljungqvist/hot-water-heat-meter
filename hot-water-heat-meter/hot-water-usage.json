  {
    "id": "269947469705ad59",
    "type": "change",
    "z": "042c9e2d2c4e8da5",
    "name": "Calculate hot water usage",
    "rules": [
      {
        "t": "set",
        "p": "usageCorrectionCoef",
        "pt": "msg",
        "to": "usageCorrectionCoef",
        "tot": "env"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "(\t    $specificHeatCapacity := 4184; /* J / (kg * K) */\t    $correction := usageCorrectionCoef; \t    $diffT := hotTemperature - coldTemperature;\t    $eInJ := payload * $specificHeatCapacity * $diffT;\t    $eInKWh := $eInJ / 1000 / 3600;\t    - $eInKWh * $correction;\t)",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 780,
    "y": 120,
    "wires": [
      []
    ]
